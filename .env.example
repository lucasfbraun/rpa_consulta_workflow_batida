PONTO_USERNAME=seu_usuario
PONTO_PASSWORD=sua_senha
PONTO_API_URL=https://relogio-ponto.lucasfbraun.workers.dev/api/records/afd
# O primeiro arquivo gerado usará este número + 1.
AFD_INITIAL_SEQUENCE=00014003750288103
# Quantidade de arquivos AFD mantidos dentro de output.
AFD_KEEP_FILES=1

ERP_URL=https://testes
ERP_USERNAME=
ERP_PASSWORD=
ERP_PROGRAM_CODE=CCRHP055
ERP_IMPORT_KIND=Apuração
# Mantenha false para o RPA não encerrar sessões de outra pessoa automaticamente.
ERP_CLOSE_ACTIVE_SESSIONS=false

# Use false apenas enquanto o ERP interno tiver certificado HTTPS não confiável.
ERP_VERIFY_TLS=false
# true executa sem abrir janela; screenshots e relatório continuam funcionando.
# Na configuração inicial, use false para acompanhar os passos no navegador.
RPA_HEADLESS=false
# Pausa global entre todas as ações do navegador, em milissegundos.
RPA_GLOBAL_DELAY_MS=300

# Relatório HTML local com screenshots de cada etapa.
MONITOR_ENABLED=true
MONITOR_OUTPUT_DIR=output/monitor
# Quantidade de execuções/screenshot mantidas. Não afeta os arquivos AFD.
MONITOR_KEEP_RUNS=1

# Publica output/monitor no Cloudflare Pages ao terminar cada execução.
# O projeto abaixo já existe; em outra máquina, autentique o Wrangler sem recriá-lo.
CLOUDFLARE_PAGES_ENABLED=false
CLOUDFLARE_PAGES_PROJECT=rpa-ponto-monitor
CLOUDFLARE_PAGES_BRANCH=main
# Necessárias no Linux sem navegador. Crie um token restrito e não o versione.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
