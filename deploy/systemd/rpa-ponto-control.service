[Unit]
Description=Consulta comandos e agendamentos do painel do RPA
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=rpa-ponto
Group=rpa-ponto
WorkingDirectory=/opt/rpa-ponto
Environment=HOME=/home/rpa-ponto
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -n /opt/rpa-ponto/output/.run.lock /opt/rpa-ponto/.venv/bin/rpa-ponto dispatch
TimeoutStartSec=35min
UMask=0077
NoNewPrivileges=true
